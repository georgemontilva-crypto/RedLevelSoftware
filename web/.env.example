# Conexión a MySQL. En Railway: añade el servicio MySQL y pon aquí la referencia ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://usuario:clave@host:3306/redlevel

# Correos (separados por coma) que pueden ver el panel /admin con los usuarios registrados
ADMIN_EMAILS=tu-correo@ejemplo.com

# Correo de contacto que se muestra en la política de privacidad
CONTACT_EMAIL=

# Repo de GitHub de donde sale el instalador (ya viene puesto por defecto)
# GITHUB_REPO=georgemontilva-crypto/RedLevelSoftware
